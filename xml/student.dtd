<!-- ===============================================================================
  The student-records root element must contain at least one or more student element.
  ============================================================================== -->
<!ELEMENT student-records (student+)>

<!-- =================================================================================
  Each student element should include name-info, student-contact, and academic-history.
  ================================================================================ -->
<!ELEMENT student (name-info, student-contact, academic-history)>

<!-- =================================================================================
  Each student should have a unique id attribute.
  ================================================================================ -->
<!ATTLIST student
    id CDATA #REQUIRED>

<!-- ================================================================================
  The name-info element contains first, middle, last, and preferred name.
  =============================================================================== -->
<!ELEMENT name-info (
  first-name,
  middle-name,
  last-name,
  preferred-name
)>

<!-- ================================================================================
  The student-contact element includes email and phone.
  =============================================================================== -->
<!ELEMENT student-contact (email, phone)>

<!-- ================================================================================
  The academic-history element contains details about the student's academics.
  =============================================================================== -->
<!ELEMENT academic-history (
  undergrad-year,
  gpa,
  major,
  minor,
  enrollment-status,
  advisor,
  enrollment-date,
  graduation-date
)>

<!-- ================================================================================
  Store plain text data for each element.
  =============================================================================== -->
<!ELEMENT first-name (#PCDATA)>
<!ELEMENT middle-name (#PCDATA)>
<!ELEMENT last-name (#PCDATA)>
<!ELEMENT preferred-name (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT phone (#PCDATA)>
<!ELEMENT undergrad-year (#PCDATA)>
<!ELEMENT gpa (#PCDATA)>
<!ELEMENT major (#PCDATA)>
<!ELEMENT minor (#PCDATA)>
<!ELEMENT enrollment-status (#PCDATA)>
<!ELEMENT advisor (#PCDATA)>
<!ELEMENT enrollment-date (#PCDATA)>
<!ELEMENT graduation-date (#PCDATA)>
